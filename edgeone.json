{
  "buildCommand": "npm run verify:edgeone",
  "installCommand": "npm ci --ignore-scripts --omit=dev",
  "outputDirectory": "./dist",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=15552000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-szxYQZsMSXG+XZNia3uWiWmh/3b3EtKPk55KzJes4fo=' 'sha256-Mv4k9zj7o6c8f8690kR+RnCMC4cx6UyroYLzQcukX2c='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://robertsspaceindustries.com https://cdn.robertsspaceindustries.com; media-src 'self'; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/assets/hero-random/v2/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pages-Cache-Control", "value": "s-maxage=7776000" }
      ]
    },
    {
      "source": "/assets/operations-motion/v2/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pages-Cache-Control", "value": "s-maxage=7776000" }
      ]
    }
  ]
}
