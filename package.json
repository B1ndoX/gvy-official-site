{
  "name": "gvy-official-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test",
    "test:site": "node --test tests/*.test.js",
    "check:js": "node scripts/check-js.mjs",
    "check:edgeone": "node scripts/check-edgeone-media.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "gallery:publisher": "npm run gallery:publisher:build && node tools/gallery-publisher/server.mjs",
    "gallery:publisher:build": "vite build --config tools/gallery-publisher/vite.config.js",
    "gallery:publisher:test": "node --test tools/gallery-publisher/tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "verify:edgeone": "GVY_SKIP_MEDIA_METADATA=1 npm run test:site && npm run check:js && npm run build",
    "verify:site": "npm run test:site && npm run check:js && npm run build",
    "verify": "npm run verify:site && npm run gallery:publisher:test && npm run gallery:publisher:build"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "gsap": "3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "@playwright/test": "1.62.1",
    "vite": "^8.2.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
