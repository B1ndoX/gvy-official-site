{
  "name": "gvy-official-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test",
    "check:js": "node scripts/check-js.mjs",
    "check:edgeone": "node scripts/check-edgeone-media.mjs",
    "gallery:publisher": "npm run gallery:publisher:build && node tools/gallery-publisher/server.mjs",
    "gallery:publisher:build": "vite build --config tools/gallery-publisher/vite.config.js",
    "gallery:publisher:test": "node --test tools/gallery-publisher/tests/*.test.js",
    "verify": "npm run test && npm run check:js && npm run build && npm run gallery:publisher:build"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "gsap": "3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5"
  }
}
