{
  "name": "gvy-ship-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5187 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/browser-check.mjs",
    "check": "npm run test && npm run build",
    "balance:generate": "node scripts/generate-defense.mjs",
    "balance:sample": "node scripts/calibrate.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
